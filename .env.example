# ============================================================
# LENSCAPE & EVENT LABS — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# Google Cloud Storage Media CDN (Public Bucket Endpoint)
# When set, media-config.js resolves video streams and high-res media from GCS.
VITE_MEDIA_CDN_URL=https://storage.googleapis.com/lenscape-media-cdn

# Google Analytics 4 Measurement IDs
# Format: G-XXXXXXXXXX (replace with your live GA4 web stream IDs)
VITE_GA4_TT_ID=G-LENSCAPE_TT
VITE_GA4_GY_ID=G-EVENTLABS_GY

# Google Tag Manager Container IDs
# Format: GTM-XXXXXXX (replace with your live GTM container IDs)
VITE_GTM_TT_ID=GTM-LENSCAPETT
VITE_GTM_GY_ID=GTM-EVENTLABSGY

# Optional Server-Side Tagging / Cloud Run Collect Endpoint
# VITE_COLLECT_ENDPOINT=https://collect.lenscapecompany.com/g/collect
